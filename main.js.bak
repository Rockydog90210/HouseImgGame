function tryAgain() {
    episodeX = randomValueFromArray(episodes);
    episodeX = 'Season 1 Episode 9';
    updateImg();
    wrongOrRight.textContent = '';
    document.getElementById('housePNG').src = "houseNet.png";
    episodeGuess.value = '';
    alreadyGussed = false;
}
